{
  "name": "😜 Commits gitmoji sem atribuição de IA",
  "target": "branch",
  "enforcement": "__ENFORCEMENT__",
  "bypass_actors": [{ "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "always" }],
  "conditions": {
    "ref_name": { "include": ["~ALL"], "exclude": [] },
    "repository_name": { "include": ["~ALL"], "exclude": [], "protected": false }
  },
  "rules": [
    { "type": "commit_message_pattern", "parameters": { "name": "gitmoji.dev/specification", "operator": "regex", "pattern": "__COMMIT_REGEX__", "negate": false } },
    { "type": "commit_message_pattern", "parameters": { "name": "sem atribuição de IA", "operator": "regex", "pattern": "__AI_REGEX__", "negate": true } }
  ]
}
