{
  "mcpServers": {
    "aws-docs": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.2.5"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_DOCUMENTATION_PARTITION": "aws" }
    },
    "aws-pricing": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@1.1.1"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_PROFILE": "ai-readonly", "AWS_REGION": "us-east-1" }
    },
    "aws-billing-cost": {
      "command": "uvx",
      "args": ["awslabs.billing-cost-management-mcp-server@0.0.45"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_PROFILE": "ai-readonly", "AWS_REGION": "us-east-1" }
    },
    "aws-iac": {
      "command": "uvx",
      "args": ["awslabs.aws-iac-mcp-server@1.0.26"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_PROFILE": "ai-readonly" }
    }
  }
}
