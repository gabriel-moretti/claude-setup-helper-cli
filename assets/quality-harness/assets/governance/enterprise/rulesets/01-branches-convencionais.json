{
  "name": "🌳 Branches convencionais",
  "target": "branch",
  "enforcement": "__ENFORCEMENT__",
  "bypass_actors": [{ "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "always" }],
  "conditions": {
    "ref_name": { "include": ["~ALL"], "exclude": [] },
    "repository_name": { "include": ["~ALL"], "exclude": [], "protected": false }
  },
  "rules": [
    { "type": "branch_name_pattern", "parameters": { "name": "Conventional Branch sem prefixos de IA", "operator": "regex", "pattern": "__BRANCH_REGEX__", "negate": false } }
  ]
}
